# WayDine Environment Configuration
# ZERO API KEYS ARE REQUIRED. The demo runs fully self-contained out-of-the-box.

# Optional: Supabase credentials (if connecting to remote cloud database)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# OSRM Public Endpoint (defaults to public OpenStreetMap routing)
# VITE_OSRM_API=https://router.project-osrm.org/route/v1/driving
